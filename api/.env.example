# Copy to .env and fill in. Never commit a real .env (it is gitignored).

# --- Database (Phase 4: Postgres only, no SQLite fallback) ---
# SQLAlchemy async URL. Defaults to the value below if unset.
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/vibecanvas

# --- Redis (Phase 6: Celery broker + result backend) ---
# Used by Celery for Tier-2 background tasks. Defaults to the value
# below if unset. Production deploys MUST override with the prod Redis.
REDIS_URL=redis://localhost:6379/0

# --- Object store (Phase 6: batch_exec result CSV upload) ---
# "inmemory" (default) — process-local, only for dev / sandbox / tests.
# "s3" — production; requires S3_BUCKET + credentials below.
OBJECT_STORE_PROVIDER=inmemory
# Optional self-hosted user-mount root. Never point this at /, HOME, or a
# directory shared with unrelated services. Per-user folders are created below
# `users/` and mirrored to encrypted VFS metadata/object storage.
MOUNT_PATH=
MOUNT_SYNC_INTERVAL_SECONDS=1.0
# S3_ENDPOINT_URL is optional — leave blank for AWS, set for MinIO /
# vendor-compatible services. Production MUST set the other four.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Independent Sandbox Service ---
# Embedded mode is reserved for isolated unit tests. Local native launch
# overrides this socket into /tmp/vibecanvas-native; Compose uses this path.
SANDBOX_SERVICE_MODE=service
SANDBOX_SERVICE_SOCKET=/run/vibecanvas-sandbox/sandboxd.sock
# Leave blank to derive unix:// from the socket. Cross-node deployments use
# grpcs://host:port and must set all three workload mTLS files below.
SANDBOX_SERVICE_ENDPOINT=
SANDBOX_SERVICE_CA_FILE=
SANDBOX_SERVICE_CERT_FILE=
SANDBOX_SERVICE_KEY_FILE=
SANDBOX_SERVICE_CONNECT_TIMEOUT_S=5
# Unary deployment jobs; interactive execution uses the streaming RPC.
SANDBOX_SERVICE_OPERATION_TIMEOUT_S=86400
# Consumed by scripts/native_dev_up.sh before application services are started.
SANDBOX_PREWARM_ON_START=1

# --- HTTP service ---
# Bearer token clients send as `Authorization: Bearer <token>`.
# If unset, a token is auto-generated and printed to stderr on startup.
VIBECANVAS_API_DEV_TOKEN=
# Comma-separated exact CORS origins. Domain, IPv4, and bracketed IPv6 with
# explicit ports are supported, e.g. http://192.168.1.20:9001.
VIBECANVAS_API_CORS_ORIGINS=
# Only socket peers in these networks may supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
# Actual HTTP bytes accepted before parsing. Keep above the largest allowed
# upload plus multipart overhead; webhook invocation remains capped at 1 MiB.
VIBECANVAS_HTTP_REQUEST_MAX_BYTES=54525952
# Optional Company OIDC SSO login. Disabled unless explicitly enabled.
ENTERPRISE_SSO_ENABLED=false
# Blank infers cookie security from VIBECANVAS_PUBLIC_URL; production always
# forces Secure cookies. Use false only for direct local/private-IP HTTP.
WEB_SESSION_COOKIE_SECURE=
# Production API/workers must leave DDL to a separate migration workload.
RUN_DATABASE_MIGRATIONS=false

# Immutable OpenFGA production pin. The one-shot production bootstrap reads
# the referenced model back and rejects any content/digest mismatch; it never
# creates a store/model or follows the latest model implicitly.
OPENFGA_API_URL=
OPENFGA_API_TOKEN=
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
OPENFGA_MODEL_SHA256=
OPENFGA_TIMEOUT_SECONDS=2

# Browser-extension capability identity. Keep this identical across the API,
# Web build/nginx frame policy, and the published MV3 manifest.
VIBECANVAS_BROWSER_EXTENSION_ID=mkfldhmlgdbpmhplaphhcfcdcoaakcik
BROWSER_TOKEN_SECRET=
PRIVILEGED_ACCESS_ENABLED=false
# Comma-separated eligible operator user UUIDs; at least two when enabled.
PRIVILEGED_SUPPORT_OPERATOR_IDS=

# --- Agent / LLM ---
# API key for the agent's LLM provider.
AGENT_API_KEY=
VIBECANVAS_DISABLE_PLATFORM_DEFAULT_API=0
RUNTIME_MODEL_EGRESS_POLICY=host

# Runtime/auth choices exposed to users (comma-separated allowlists).
AGENT_RUNTIME_TYPES=langchain,codex
CODEX_RUNTIME_AUTH_METHODS=chatgpt,managed_api,personal_api
# Example shape only:
# [{"id":"platform-default","name":"Platform Default","base_url":"https://openai.example.test/v1","api_key":"...","models":["gpt-5.2-codex"]}]
CODEX_MANAGED_APIS_JSON=[]
# Private persistent Codex state/account root (0700). Leave blank for the local
# default; deployment Compose sets a dedicated named-volume path.
AGENT_RUNTIME_ROOT=
# Optional legacy plaintext Chat Runtime root. It is read only as an automatic
# migration source; new state is encrypted in the configured Object Store and
# receives an ephemeral private POSIX projection while a sandbox is active.
VFS_VOLUME_ROOT=


# --- Storage paths (legacy file store; Postgres is the system of record) ---
# Ephemeral local root for the pre-Phase-4 file store. Optional.
VIBECANVAS_STORAGE_ROOT=
# Override used by the FastAPI app layer for its storage root. Optional.
VIBECANVAS_API_STORAGE_ROOT=
# Optional permanent backup root (local fs path or hdfs:// URL).
# When set, writes under the storage root are mirrored here.
VIBECANVAS_BACKUP_PATH=
# Per-file application upload cap (50 MiB by default).
VIBECANVAS_VFS_UPLOAD_MAX_BYTES=52428800

# --- Cluster role + queue routing (Deployments) ---
# 'monolith' for single-node; 'control_plane' or 'data_plane' for split deploys.
CLUSTER_ROLE=monolith
# Comma-separated Celery queue names this worker subscribes to. Producers pass
# `queue=` via route_for(); workers read this on startup.
CELERY_QUEUES=interactive,deployments
